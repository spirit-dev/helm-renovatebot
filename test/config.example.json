{
  "platform": "gitlab",
  "endpoint": "https://gitlab.com/api/v4",
  "token": "",
  "autodiscover": "false",
  "dryRun": false,
  "printConfig": true,
  "onboardingConfig": {
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
      "local>templates/renovate-config//renovate/default"
    ]
  },
  "hostRules": [
    {
      "matchHost": "github.com",
      "token": ""
    },
    {
      "matchHost": "gitlab.com",
      "token": ""
    },
    {
      "matchHost": "gitlab-registry.com",
      "username": "renovate-bot",
      "password": "",
      "hostType": "docker"
    }
  ],
  "repositories": [
    "group/repo"
  ]
}
